+#[cfg(test)]
+mod proving_memory_tests {
+    use super::{ExecutionPool, proving_debug};
+
+    #[test]
+    #[cfg(target_pointer_width = "64")]
+    fn allocation_counters_preserve_sizes_above_four_gib() {
+        use proving_debug::*;
+        use std::sync::atomic::Ordering;
+
+        let saved = COUNTERS.each_ref().map(|word| word.load(Ordering::Relaxed));
+        let amount = u32::MAX as usize + 4097;
+        allocated(amount);
+        assert_eq!(COUNTERS[ALLOCATED].load(Ordering::Relaxed) as u64, saved[ALLOCATED] as u64 + amount as u64);
+        assert!(COUNTERS[PEAK_ALLOCATED].load(Ordering::Relaxed) as u64 >= amount as u64);
+        allocation_failed(amount);
+        assert_eq!(COUNTERS[LAST_FAILED_ALLOCATION].load(Ordering::Relaxed) as u64, amount as u64);
+        deallocated(amount);
+        assert_eq!(COUNTERS[ALLOCATED].load(Ordering::Relaxed), saved[ALLOCATED]);
+        for (word, value) in COUNTERS.iter().zip(saved) {
+            word.store(value, Ordering::Relaxed);
+        }
+    }
+
+    #[test]
+    fn sequential_outer_jobs_keep_order_and_run_on_calling_thread() {
+        let caller = std::thread::current().id();
+        let mut pool = ExecutionPool::with_capacity(8);
+        for value in 0..8 {
+            pool.add_job(move || {
+                assert_eq!(std::thread::current().id(), caller);
+                value * value
+            });
         }
+        proving_debug::set_memory_mode(1);
+        let result = pool.execute_all();
+        proving_debug::set_memory_mode(0);
+        assert_eq!(result, (0..8).map(|value| value * value).collect::<Vec<_>>());
     }
 }
 
