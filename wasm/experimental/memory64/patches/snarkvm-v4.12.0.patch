+                            .expect("valid test fixture")
+                    );
+                    let bytes = proof.to_bytes_le().expect("valid proof");
+                    if let Some(stock) = &stock_bytes {
+                        assert_eq!(&bytes, stock, "Proof bytes differ for mode {mode}");
+                    } else {
+                        stock_bytes = Some(bytes);
