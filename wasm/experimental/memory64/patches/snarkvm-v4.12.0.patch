+/// Public, non-secret counters for the isolated proving memory experiment.
+pub mod proving_debug {
+    use std::sync::atomic::{AtomicUsize, Ordering};
+
+    pub const MAGIC: u32 = 0x53485044;
+    pub const VERSION: u32 = 3;
+    pub const WORDS: usize = 16;
+    pub const MODE: usize = 2;
+    pub const STAGE: usize = 3;
+    pub const STAGE_SEQUENCE: usize = 4;
+    pub const JOBS_STARTED: usize = 5;
+    pub const JOBS_COMPLETED: usize = 6;
+    pub const JOBS_ACTIVE: usize = 7;
+    pub const ALLOCATED: usize = 8;
+    pub const PEAK_ALLOCATED: usize = 9;
+    pub const ALLOCATION_FAILURES: usize = 10;
+    pub const LAST_FAILED_ALLOCATION: usize = 11;
+    pub const ALLOCATION_COUNT: usize = 12;
+    pub const DEALLOCATION_COUNT: usize = 13;
+    pub const REALLOCATION_COUNT: usize = 14;
+    pub const MSM_WINDOWS_ACTIVE: usize = 15;
+
+    pub static COUNTERS: [AtomicUsize; WORDS] = [
+        AtomicUsize::new(MAGIC as usize),
+        AtomicUsize::new(VERSION as usize),
+        AtomicUsize::new(0),
+        AtomicUsize::new(0),
+        AtomicUsize::new(0),
+        AtomicUsize::new(0),
+        AtomicUsize::new(0),
+        AtomicUsize::new(0),
+        AtomicUsize::new(0),
+        AtomicUsize::new(0),
+        AtomicUsize::new(0),
+        AtomicUsize::new(0),
+        AtomicUsize::new(0),
+        AtomicUsize::new(0),
+        AtomicUsize::new(0),
+        AtomicUsize::new(0),
+    ];
+
+    pub fn memory_mode() -> u32 {
+        COUNTERS[MODE].load(Ordering::Relaxed) as u32
+    }
+
+    pub fn set_memory_mode(mode: u32) {
+        COUNTERS[MODE].store(mode as usize, Ordering::Relaxed);
+    }
+
+    pub fn stage(stage: u32) {
+        COUNTERS[STAGE].store(stage as usize, Ordering::Release);
+        COUNTERS[STAGE_SEQUENCE].fetch_add(1, Ordering::Release);
+    }
+
+    pub fn run_job<T>(job: impl FnOnce() -> T) -> T {
+        struct ActiveJob;
+        impl Drop for ActiveJob {
+            fn drop(&mut self) {
+                COUNTERS[JOBS_ACTIVE].fetch_sub(1, Ordering::Relaxed);
+            }
+        }
+        COUNTERS[JOBS_STARTED].fetch_add(1, Ordering::Relaxed);
+        COUNTERS[JOBS_ACTIVE].fetch_add(1, Ordering::Relaxed);
+        let guard = ActiveJob;
+        let result = job();
+        COUNTERS[JOBS_COMPLETED].fetch_add(1, Ordering::Relaxed);
+        drop(guard);
+        result
+    }
+
+    pub fn run_msm_window<T>(window: impl FnOnce() -> T) -> T {
+        struct ActiveWindow;
+        impl Drop for ActiveWindow {
+            fn drop(&mut self) {
+                COUNTERS[MSM_WINDOWS_ACTIVE].fetch_sub(1, Ordering::Relaxed);
+            }
+        }
+        COUNTERS[MSM_WINDOWS_ACTIVE].fetch_add(1, Ordering::Relaxed);
+        let guard = ActiveWindow;
+        let result = window();
+        drop(guard);
+        result
+    }
+
+    pub fn allocated(size: usize) {
+        let total = COUNTERS[ALLOCATED].fetch_add(size, Ordering::Relaxed) + size;
+        COUNTERS[PEAK_ALLOCATED].fetch_max(total, Ordering::Relaxed);
+    }
+
+    pub fn deallocated(size: usize) {
+        COUNTERS[ALLOCATED].fetch_sub(size, Ordering::Relaxed);
+    }
+
+    pub fn allocation_failed(size: usize) {
+        COUNTERS[ALLOCATION_FAILURES].fetch_add(1, Ordering::Relaxed);
+        COUNTERS[LAST_FAILED_ALLOCATION].store(size, Ordering::Relaxed);
+    }
+}
