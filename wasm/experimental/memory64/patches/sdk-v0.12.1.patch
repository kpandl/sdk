+use snarkvm_algorithms::proving_debug::{self, COUNTERS};
+use std::{
+    alloc::{GlobalAlloc, Layout, System},
+    sync::atomic::Ordering,
+};
+use wasm_bindgen::prelude::*;
+
+struct ObservedAllocator;
+
+// All allocation operations are forwarded unchanged to Rust's existing system allocator.
+// Counters use only atomics and cannot allocate or recursively invoke this allocator.
+unsafe impl GlobalAlloc for ObservedAllocator {
+    unsafe fn alloc(&self, layout: Layout) -> *mut u8 {
+        let pointer = unsafe { System.alloc(layout) };
+        COUNTERS[proving_debug::ALLOCATION_COUNT].fetch_add(1, Ordering::Relaxed);
+        if pointer.is_null() {
+            proving_debug::allocation_failed(layout.size());
+        } else {
+            proving_debug::allocated(layout.size());
+        }
+        emit_progress(layout.size(), pointer.is_null());
+        pointer
+    }
+
+    unsafe fn alloc_zeroed(&self, layout: Layout) -> *mut u8 {
+        let pointer = unsafe { System.alloc_zeroed(layout) };
+        COUNTERS[proving_debug::ALLOCATION_COUNT].fetch_add(1, Ordering::Relaxed);
+        if pointer.is_null() {
+            proving_debug::allocation_failed(layout.size());
+        } else {
+            proving_debug::allocated(layout.size());
+        }
+        emit_progress(layout.size(), pointer.is_null());
+        pointer
+    }
+
+    unsafe fn dealloc(&self, pointer: *mut u8, layout: Layout) {
+        unsafe { System.dealloc(pointer, layout) };
+        proving_debug::deallocated(layout.size());
+        COUNTERS[proving_debug::DEALLOCATION_COUNT].fetch_add(1, Ordering::Relaxed);
+        emit_progress(layout.size(), false);
+    }
+
+    unsafe fn realloc(&self, pointer: *mut u8, layout: Layout, size: usize) -> *mut u8 {
+        let result = unsafe { System.realloc(pointer, layout, size) };
+        COUNTERS[proving_debug::REALLOCATION_COUNT].fetch_add(1, Ordering::Relaxed);
+        if result.is_null() {
+            proving_debug::allocation_failed(size);
+        } else if size >= layout.size() {
+            proving_debug::allocated(size - layout.size());
+        } else {
+            proving_debug::deallocated(layout.size() - size);
+        }
+        emit_progress(size, result.is_null());
+        result
+    }
+}
+
+#[global_allocator]
+static ALLOCATOR: ObservedAllocator = ObservedAllocator;
+
+/// 0 preserves stock scheduling; 1 serializes outer jobs; 2 also serializes MSM windows.
+#[wasm_bindgen(js_name = "setProvingMemoryMode")]
+pub fn set_proving_memory_mode(mode: u32) -> Result<(), JsValue> {
+    if mode > 2 {
+        return Err(JsValue::from_str("Proving memory mode must be 0, 1, or 2"));
+    }
+    let stage = COUNTERS[proving_debug::STAGE].load(Ordering::Acquire);
+    if COUNTERS[proving_debug::JOBS_ACTIVE].load(Ordering::Relaxed) != 0
+        || COUNTERS[proving_debug::MSM_WINDOWS_ACTIVE].load(Ordering::Relaxed) != 0
+        || (100..190).contains(&stage)
+    {
+        return Err(JsValue::from_str("Cannot change proving memory mode while jobs are active"));
+    }
+    proving_debug::set_memory_mode(mode);
+    Ok(())
+}
+
+/// A fixed, aligned atomic counter block containing no inputs, keys, witnesses, or allocations' contents.
+#[wasm_bindgen(js_name = "getProvingDiagnosticsPointer")]
+pub fn get_proving_diagnostics_pointer() -> usize {
+    COUNTERS.as_ptr() as usize
+}
+
+#[wasm_bindgen(js_name = "getProvingDiagnosticsMemory")]
+pub fn get_proving_diagnostics_memory() -> JsValue {
+    wasm_bindgen::memory()
+}
+
+#[wasm_bindgen(js_name = "getProvingDiagnostics")]
+pub fn get_proving_diagnostics() -> Vec<f64> {
+    COUNTERS.iter().map(|counter| counter.load(Ordering::Relaxed) as f64).collect()
+}
+
+#[wasm_bindgen(inline_js = r#"
+export function reportAllocationSample(force) {
+    globalThis.__shieldProvingAllocationSample?.(force);
+}
+"#)]
+extern "C" {
+    #[wasm_bindgen(js_name = reportAllocationSample)]
+    fn report_allocation_sample(force: bool);
+}
+
+fn emit_progress(size: usize, failed: bool) {
+    let operations = COUNTERS[proving_debug::ALLOCATION_COUNT]
+        .load(Ordering::Relaxed)
+        .wrapping_add(COUNTERS[proving_debug::DEALLOCATION_COUNT].load(Ordering::Relaxed))
+        .wrapping_add(COUNTERS[proving_debug::REALLOCATION_COUNT].load(Ordering::Relaxed));
+    if failed || size >= 1_048_576 || operations & 0xFFFF == 0 {
+        report_allocation_sample(failed);
+    }
+}
+
+#[wasm_bindgen(js_name = "getProvingDiagnosticsWordBytes")]
+pub fn get_proving_diagnostics_word_bytes() -> usize {
+    std::mem::size_of::<usize>()
+}
+
+#[wasm_bindgen(js_name = "getProvingPointerBytes")]
+pub fn get_proving_pointer_bytes() -> usize {
+    std::mem::size_of::<usize>()
+}
