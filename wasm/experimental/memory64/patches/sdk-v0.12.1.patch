@@ -0,0 +1,83 @@
+import fs from "node:fs";
+import os from "node:os";
+import path from "node:path";
+import { spawnSync } from "node:child_process";
+import { createHash } from "node:crypto";
+
+const target = process.argv.find((arg) => arg.startsWith("--target="))?.slice(9)
+  ?? "wasm64-unknown-unknown";
+if (!["wasm64-unknown-unknown", "wasm32-unknown-unknown"].includes(target))
+  throw new Error("Unsupported single-thread target");
+const pointerBytes = target.startsWith("wasm64") ? 8 : 4;
+const output = path.resolve(`dist/mainnet-single${pointerBytes * 8}`);
+const maximumBytes = pointerBytes === 8 ? 8_589_934_592 : 4_294_967_296;
+const bindgen = process.env.PROVING_LAB_BINDGEN ??
+  "../../shield-extension/dist/proving-lab-memory64-rust/tools/wasm-bindgen-0.2.129-aarch64-apple-darwin/wasm-bindgen";
+const rustflags = [
+  "-C", "link-arg=--max-memory=" + maximumBytes,
+  "-C", "debuginfo=0", "-C", "strip=none",
+  "--remap-path-prefix", `${path.join(os.homedir(), ".cargo")}=cargo`,
+  "--remap-path-prefix", `${path.join(os.homedir(), ".rustup")}=rustup`,
+  "--remap-path-prefix", `${path.resolve("../..")}=workspace`,
+].join(" ");
+const environment = {
+  ...process.env,
+  RUSTFLAGS: rustflags,
+  CARGO_BUILD_JOBS: process.env.CARGO_BUILD_JOBS ?? "2",
+  CARGO_INCREMENTAL: "0",
+};
+const run = (command, args) => {
+  const result = spawnSync(command, args, { env: environment, stdio: "inherit" });
+  if (result.error) throw result.error;
+  if (result.status !== 0) throw new Error(`${path.basename(command)} failed (${result.status})`);
+};
+const started = Date.now();
+run("cargo", [
+  "build", "--locked", "--offline", "--release", "--target", target,
+  "--no-default-features", "--features", "browser,mainnet,serial",
+  "--config", 'profile.release.panic="abort"',
+  "--config", "profile.release.codegen-units=1",
+  "-Zbuild-std=std,panic_abort", "-Zbuild-std-features=optimize_for_size",
+]);
+fs.mkdirSync(output, { recursive: true });
+run(bindgen, [
+  path.resolve(`target/${target}/release/aleo_wasm.wasm`),
+  "--target", "web", "--keep-debug", "--out-name", "aleo_wasm", "--out-dir", output,
+]);
+const raw = path.join(output, "aleo_wasm_bg.wasm");
+const wasm = path.join(output, "aleo_wasm.wasm");
+run("../.build-tools/binaryen/bin/wasm-opt", [
+  raw, "-O", "--debuginfo", "--enable-memory64", "--enable-bulk-memory",
+  "--enable-nontrapping-float-to-int", "-o", wasm,
+]);
+fs.unlinkSync(raw);
+fs.writeFileSync(path.join(output, "index.js"), `
+import initialize, { initThreadPool as initializePool } from "./aleo_wasm.js";
+export * from "./aleo_wasm.js";
+await initialize({ module_or_path: new URL("./aleo_wasm.wasm", import.meta.url) });
+export async function initThreadPool(threads = 1) {
+  if (threads !== 1) throw new Error("This diagnostic package is single-threaded");
+  await initializePool(new URL("worker.js", import.meta.url), threads);
+}
+`);
+fs.writeFileSync(path.join(output, "worker.js"),
+  'throw new Error("Single-thread diagnostic package cannot start Rayon workers");\n');
+const sha = (file) => createHash("sha256").update(fs.readFileSync(file)).digest("hex");
+const metadata = {
+  diagnosticBuild: `wasm${pointerBytes * 8}-single`,
+  sdkVersion: "0.12.1", snarkvmVersion: "4.12.0",
+  sdkRevision: "6fca0da897ce85baff3890d287ebfc7d9b518ffa",
+  snarkvmRevision: "56b6c6025c96cc1e36aacdb8edc008a910f8ba9e",
+  target, pointerBytes, counterWordBytes: pointerBytes, counterSchema: 3,
+  sharedMemory: false, threads: 1, maximumBytes,
+  toolchain: "nightly-2026-04-02", wasmBindgen: "0.2.129", binaryen: "125",
+  profile: { optLevel: 3, lto: true, codegenUnits: 1, panic: "abort" },
+  cargoLockSha256: sha("Cargo.lock"), buildScriptSha256: sha("build-single.mjs"),
+  elapsedMs: Date.now() - started,
+  artifacts: Object.fromEntries(["aleo_wasm.wasm", "aleo_wasm.js", "index.js", "worker.js"]
+    .map((name) => [name, { bytes: fs.statSync(path.join(output, name)).size,
+      sha256: sha(path.join(output, name)) }])),
+};
+fs.writeFileSync(path.join(output, "proving-memory-build.json"), JSON.stringify(metadata, null, 2) + "\n");
+console.log(JSON.stringify({ event: "single-build-completed", target,
+  wasmSha256: metadata.artifacts["aleo_wasm.wasm"].sha256, elapsedMs: metadata.elapsedMs }));
